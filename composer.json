{
    "name": "bps-jember/sipandhalu",
    "description": "SIPANDHALU - Sistem Informasi Pandhalungan Susenas-Seruti (native PHP 8.2 + MySQL 8)",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "phpoffice/phpspreadsheet": "^5.9"
    },
    "require-dev": {
        "phpunit/phpunit": "10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
