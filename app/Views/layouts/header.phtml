$isPengolah = (($user['role_code'] ?? '') === 'PENGOLAH');
$active = function (string $prefix): string {
    $uri = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/';
    if ($prefix === '/') {
        return ($uri === '/' || $uri === '') ? 'active' : '';
    }
    return str_starts_with($uri, $prefix) ? 'active' : '';
};
