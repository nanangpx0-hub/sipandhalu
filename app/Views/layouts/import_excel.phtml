<?php
/**
 * Partial modal + laporan impor Excel.
 * Variabel sebelum include: $importUrl (string, action POST),
 * $templateUrl (string|null, link unduh template), $import_errors (array<int,string>|null).
 */
use App\Core\Csrf;
use App\Core\View;
?>
<?php if (!empty($import_errors)): ?>
<div class="card border-warning mb-3">
  <div class="card-header bg-warning"><b><i class="fas fa-exclamation-triangle mr-1"></i>Baris yang dilewati/gagal saat impor</b></div>
  <div class="card-body py-2" style="max-height:240px;overflow:auto">
    <ul class="mb-0 pl-3 small">
      <?php foreach ($import_errors as $ie): ?><li><?= View::e($ie) ?></li><?php endforeach; ?>
    </ul>
  </div>
</div>
<?php endif; ?>
<div class="modal fade" id="modalImport" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <form class="modal-content" method="post" action="<?= View::e($importUrl) ?>" enctype="multipart/form-data">
      <?= Csrf::field() ?>
      <div class="modal-header bg-primary">
        <h5 class="modal-title"><i class="fas fa-file-excel mr-1"></i> Import dari Excel</h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
      </div>
      <div class="modal-body">
        <?php if (!empty($templateUrl)): ?>
        <p><a href="<?= View::e($templateUrl) ?>" class="btn btn-sm btn-outline-success"><i class="fas fa-download mr-1"></i>Unduh Template</a></p>
        <?php endif; ?>
        <p class="small text-muted">Pilih file .xlsx/.xls (maks 5 MB, 2000 baris). Baris duplikat/data tidak valid akan dilewati dan dilaporkan.</p>
        <div class="custom-file">
          <input type="file" class="custom-file-input" id="file_excel" name="file_excel" accept=".xlsx,.xls" required>
          <label class="custom-file-label" for="file_excel">Pilih file Excel…</label>
        </div>
      </div>
      <div class="modal-footer justify-content-between">
        <button type="button" class="btn btn-default" data-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-upload mr-1"></i>Import</button>
      </div>
    </form>
  </div>
</div>
<script>
document.addEventListener('change', function (e) {
  if (e.target && e.target.id === 'file_excel') {
    var lbl = document.querySelector('label[for="file_excel"]');
    if (lbl && e.target.files.length) { lbl.textContent = e.target.files[0].name; }
  }
});
</script>
