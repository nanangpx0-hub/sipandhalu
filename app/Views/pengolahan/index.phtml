<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';

  var csrfToken = '<?= \App\Core\Csrf::token() ?>';
  window.CAN_EDIT = <?= $canEdit ? 'true' : 'false' ?>;
  $.ajaxSetup({
    data: { _csrf: csrfToken }
  });

  function showNotification(msg, isSuccess) {
    var html = '<div class="alert alert-' + (isSuccess ? 'success' : 'danger') + ' alert-dismissible fade show py-2" role="alert">' +
      '<i class="fas ' + (isSuccess ? 'fa-check-circle' : 'fa-exclamation-triangle') + ' mr-2"></i>' + msg +
      '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>' +
      '</div>';
    $('#ajaxAlertContainer').html(html);
    setTimeout(function () {
      $('#ajaxAlertContainer .alert').alert('close');
    }, 4000);
  }

  /** Daftarkan handler delegasi HANYA untuk pengguna berwenang (RBAC read-only). */
  function onEdit(event, selector, handler) {
    if (!window.CAN_EDIT) { return; }
    $(document).on(event, selector, handler);
  }

  /** Daftarkan handler langsung HANYA untuk pengguna berwenang (RBAC read-only). */
  function bindEdit(target, event, handler) {
    if (!window.CAN_EDIT) { return; }
    $(target).on(event, handler);
  }

  /** Tolak aksi mutasi dari peran read-only + beri umpan balik (pertahanan berlapis). */
  function tolakReadOnly() {
    showNotification('Mode tinjau: hanya Admin & Operator Tim IPDS yang berwenang mengubah data pengolahan.', false);
  }

  // Pertahanan berlapis: blokir elemen mutasi bila markup dipaksa tampil (mode tinjau).
  if (!window.CAN_EDIT) {
    $(document).on('click change submit', '.btn-toggle-dok, .chk-transfer, .btn-batch-action, .btn-batch-header', function (e) {
      e.preventDefault();
      e.stopImmediatePropagation();
      tolakReadOnly();
    });
  }

  // 1. AJAX Toggle Status Dokumen (ADA / BELUM) — hanya editor
  onEdit('click', '.btn-toggle-dok', function () {
    var btn = $(this);
    var rutaId = btn.data('id');
    var currentVal = btn.data('val');
    var newVal = (currentVal === 'ADA') ? 'BELUM' : 'ADA';

    btn.prop('disabled', true);
    $.post('/pengolahan/update-ruta', {
      ruta_id: rutaId,
      status_dokumen: newVal
    }, function (res) {
      btn.prop('disabled', false);
      if (res.success) {
        btn.data('val', newVal);
        if (newVal === 'ADA') {
          btn.removeClass('btn-outline-secondary').addClass('btn-info');
          btn.html('<i class="fas fa-check-circle mr-1"></i>ADA');
          var dokTitle = 'Status: ADA' +
            (res.data && res.data.tgl_pengiriman ? '<br>Tgl Terima: ' + res.data.tgl_pengiriman : '') +
            (res.data && res.data.ttd_sos ? '<br>Diserahkan: ' + res.data.ttd_sos : '') +
            (res.data && res.data.ttd_ipds ? '<br>Diterima: ' + res.data.ttd_ipds : '');
          btn.attr('data-original-title', dokTitle).attr('title', dokTitle).tooltip('dispose').tooltip();
          if (res.data && res.data.tgl_pengiriman && btn.next('.dok-tgl').length === 0) {
            btn.after('<div class="dok-tgl small text-muted font-italic mt-1" style="font-size: 0.72rem;" title="Tanggal diterima Tim IPDS"><i class="far fa-calendar-alt mr-1 text-info"></i>' + res.data.tgl_pengiriman + '</div>');
          }
        } else {
          btn.removeClass('btn-info').addClass('btn-outline-secondary');
          btn.html('<i class="fas fa-times-circle mr-1"></i>BELUM');
          btn.attr('data-original-title', 'Klik untuk ubah status dokumen fisik').attr('title', 'Klik untuk ubah status dokumen fisik').tooltip('dispose').tooltip();
          btn.next('.dok-tgl').remove();
        }
        var row = $('#row_' + rutaId);
        var detailBtn = row.find('.btn-detail-catatan');
        if (detailBtn.length && res.data) {
          detailBtn.data('json', res.data);
        }
        showNotification('Status dokumen fisik berhasil diubah menjadi ' + newVal, true);
      } else {
        showNotification(res.message || 'Gagal mengubah status dokumen.', false);
      }
    }).fail(function (xhr) {
      btn.prop('disabled', false);
      var err = xhr.responseJSON ? xhr.responseJSON.message : 'Terjadi kesalahan server.';
      showNotification(err, false);
    });
  });

  // 2. AJAX Checkbox Status Transfer — hanya editor
  onEdit('change', '.chk-transfer', function () {
    var chk = $(this);
    var rutaId = chk.data('id');
    var field = chk.data('field');
    var isChecked = chk.prop('checked') ? 1 : 0;

    chk.prop('disabled', true);
    var postData = { ruta_id: rutaId };
    postData[field] = isChecked;

    $.post('/pengolahan/update-ruta', postData, function (res) {
      chk.prop('disabled', false);
      if (res.success) {
        showNotification('Status transfer berhasil disimpan.', true);
      } else {
        chk.prop('checked', !isChecked);
        showNotification(res.message || 'Gagal menyimpan transfer.', false);
      }
    }).fail(function (xhr) {
      chk.prop('disabled', false);
      chk.prop('checked', !isChecked);
      var err = xhr.responseJSON ? xhr.responseJSON.message : 'Gagal menyimpan.';
      showNotification(err, false);
    });
  });

  // 3. Buka Modal Telaah Catatan Error
  $(document).on('click', '.btn-detail-catatan', function () {
    var data = $(this).data('json');
    if (!data) return;

    $('#modal_ruta_id').val(data.id);
    $('#m_nks').text(data.nks);
    $('#m_wilayah').text((data.nama_desa || '-') + ' / ' + (data.nama_kecamatan || '-'));
    $('#m_ruta').text('Ruta ' + data.no_urut_ruta);
    $('#m_pengolah').text(data.nama_pengolah || '-');
    $('#m_pcl').text(data.nama_pcl || '-');
    $('#m_pml').text(data.nama_pml || '-');

    // Status Dokumen & Metadata Penerimaan
    $('#m_status_dokumen').val(data.status_dokumen || 'BELUM');
    $('#m_tgl_pengiriman').val(data.tgl_pengiriman || '');
    $('#m_ttd_sos').val(data.ttd_sos || (data.nama_pml ? data.nama_pml + ' (Tim Sosial)' : ''));
    $('#m_ttd_ipds').val(data.ttd_ipds || (data.nama_pengolah ? data.nama_pengolah + ' (Tim IPDS)' : ''));

    // Status Transfer
    $('#m_status_transfer_k').prop('checked', parseInt(data.status_transfer_k) === 1);
    $('#m_status_transfer_kp').prop('checked', parseInt(data.status_transfer_kp) === 1);
    $('#m_status_transfer_seruti').prop('checked', parseInt(data.status_transfer_seruti) === 1);

    $('#m_ket_kp_pengolah').val(data.ket_kp_pengolah || '');
    $('#m_ket_kp_lapangan').val(data.ket_kp_lapangan || '');
    $('#m_ket_kp_sosial').val(data.ket_kp_sosial || '');
    $('#m_ket_kp_ipds').val(data.ket_kp_ipds || '');

    $('#m_ket_m_pengolah').val(data.ket_m_pengolah || '');
    $('#m_ket_m_lapangan').val(data.ket_m_lapangan || '');
    $('#m_ket_m_sosial').val(data.ket_m_sosial || '');
    $('#m_ket_m_ipds').val(data.ket_m_ipds || '');

    $('#m_uji_petik_pengawas').val(data.uji_petik_pengawas || '');

    $('#modalCatatan').modal('show');
  });

  // Handler auto-fill tanggal hari ini saat status dokumen diubah jadi ADA di modal — hanya editor
  bindEdit('#m_status_dokumen', 'change', function () {
    if ($(this).val() === 'ADA') {
      if (!$('#m_tgl_pengiriman').val()) {
        var today = new Date().toISOString().slice(0, 10);
        $('#m_tgl_pengiriman').val(today);
      }
    }
  });

  // Auto-fill nama pengawas bertugas ke textarea Uji Petik — hanya editor
  var pengawasAktif = <?= json_encode($pengawasHariIni['nama_pengawas'] ?? $pengawasHariIni['orang_nama'] ?? '') ?>;
  onEdit('click', '#btnAutofillPengawas', function () {
    var cur = $('#m_uji_petik_pengawas').val() || '';
    var prefix = pengawasAktif !== '' ? ('Uji petik oleh ' + pengawasAktif + ' (' + <?= json_encode($todayYmd ?? date('Y-m-d')) ?> + '): ') : '';
    if (cur !== '' && prefix !== '' && cur.indexOf(pengawasAktif) === -1) {
      $('#m_uji_petik_pengawas').val(cur.replace(/\s+$/, '') + '\n' + prefix);
    } else if (cur === '' && prefix !== '') {
      $('#m_uji_petik_pengawas').val(prefix);
    }
    $('#m_uji_petik_pengawas').focus();
  });

  // Pilih NKS di Modal Terima Dokumen 1 SLS — hanya editor
  bindEdit('#batch_terima_nks', 'change', function () {
    var opt = $(this).find('option:selected');
    var pml = opt.data('pml');
    var pengolah = opt.data('pengolah');
    if (pml) {
      $('#batch_ttd_sos').val(pml + ' (Tim Sosial)');
    } else {
      $('#batch_ttd_sos').val('Tim Sosial');
    }
    if (pengolah) {
      $('#batch_ttd_ipds').val(pengolah + ' (Tim IPDS)');
    }
  });

  // Simpan Form Terima Dokumen 1 SLS — hanya editor
  bindEdit('#formTerimaDokumenBatch', 'submit', function (e) {
    e.preventDefault();
    var btn = $('#btnSubmitBatchTerima');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Memproses...');

    $.post('/pengolahan/terima-dokumen', $(this).serialize(), function (res) {
      btn.prop('disabled', false).html('<i class="fas fa-check-double mr-1"></i>Simpan Penerimaan 10 Dokumen');
      if (res.success) {
        $('#modalTerimaDokumenBatch').modal('hide');
        showNotification(res.message, true);
        setTimeout(function () {
          location.reload();
        }, 800);
      } else {
        alert(res.message || 'Gagal menyimpan penerimaan dokumen.');
      }
    }).fail(function (xhr) {
      btn.prop('disabled', false).html('<i class="fas fa-check-double mr-1"></i>Simpan Penerimaan 10 Dokumen');
      var err = xhr.responseJSON ? xhr.responseJSON.message : 'Terjadi kesalahan sistem.';
      alert('Error: ' + err);
    });
  });

  // 4. Simpan Form Modal Catatan — hanya editor
  bindEdit('#formCatatan', 'submit', function (e) {
    e.preventDefault();
    var btn = $('#btnSimpanCatatan');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Menyimpan...');

    var formArr = $(this).serializeArray();
    var checkedMap = {
      status_transfer_k: $('#m_status_transfer_k').is(':checked') ? 1 : 0,
      status_transfer_kp: $('#m_status_transfer_kp').is(':checked') ? 1 : 0,
      status_transfer_seruti: $('#m_status_transfer_seruti').is(':checked') ? 1 : 0
    };
    formArr = formArr.filter(function (item) {
      return !(item.name in checkedMap);
    });
    for (var k in checkedMap) {
      formArr.push({ name: k, value: checkedMap[k] });
    }
    var formData = $.param(formArr);

    $.post('/pengolahan/update-ruta', formData, function (res) {
      btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i>Simpan Perubahan');
      if (res.success) {
        $('#modalCatatan').modal('hide');
        showNotification('Catatan & status transfer berhasil disimpan!', true);
        setTimeout(function () {
          location.reload();
        }, 800);
      } else {
        alert(res.message || 'Gagal menyimpan catatan.');
      }
    }).fail(function (xhr) {
      btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i>Simpan Perubahan');
      var err = xhr.responseJSON ? xhr.responseJSON.message : 'Terjadi kesalahan sistem.';
      alert('Error: ' + err);
    });
  });

  // 5. Batch Transfer Action (All visible rows or header click) — hanya editor
  onEdit('click', '.btn-batch-action, .btn-batch-header', function (e) {
    e.preventDefault();
    var btn = $(this);
    var field = btn.data('field');
    var val = btn.data('val') !== undefined ? parseInt(btn.data('val')) : 1;
    var fieldLabel = (field === 'status_transfer_k') ? 'Transfer K (Kor)' : ((field === 'status_transfer_kp') ? 'Transfer KP' : 'Transfer Seruti');
    var actionLabel = (val === 1) ? 'menandai SELESAI' : 'MEMBATALKAN';

    var rutaIds = [];
    $('.chk-transfer[data-field="' + field + '"]').each(function () {
      rutaIds.push(parseInt($(this).data('id')));
    });

    if (rutaIds.length === 0) {
      showNotification('Tidak ada baris ruta yang dapat diperbarui.', false);
      return;
    }

    if (!confirm('Apakah Anda yakin ingin ' + actionLabel + ' ' + fieldLabel + ' untuk ' + rutaIds.length + ' ruta yang ditampilkan?')) {
      return;
    }

    btn.prop('disabled', true);
    $.post('/pengolahan/batch-transfer', {
      field: field,
      value: val,
      periode_id: <?= $currentPeriodeId ?>,
      ruta_ids: rutaIds
    }, function (res) {
      btn.prop('disabled', false);
      if (res.success) {
        $('.chk-transfer[data-field="' + field + '"]').prop('checked', val === 1);
        showNotification(res.message, true);
        setTimeout(function () {
          location.reload();
        }, 1000);
      } else {
        showNotification(res.message || 'Gagal memperbarui transfer.', false);
      }
    }).fail(function (xhr) {
      btn.prop('disabled', false);
      var err = xhr.responseJSON ? xhr.responseJSON.message : 'Gagal memperbarui transfer.';
      showNotification(err, false);
    });
  });

  $('[data-toggle="tooltip"]').tooltip();
});
</script>

