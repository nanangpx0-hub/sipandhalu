<?php
$petugasOptions = $petugasOptions ?? [];
$peranMap = $peranMap ?? [];
$opt = static function (?string $current, string $peran) use ($petugasOptions, $peranMap): string {
    $h = '<option value="">— Pilih —</option>';
    foreach ($petugasOptions as $o) {
        $oid = (int) $o['id'];
        $perans = $peranMap[$oid] ?? [];
        $k4 = ($perans !== [] && !in_array($peran, $perans, true)) ? ' · ⚠ ' . implode('/', $perans) : '';
        $sel = ($current !== null && $current !== '' && $current === $o['nama']) ? ' selected' : '';
        $h .= '<option value="' . $oid . '"' . $sel . '>' . \App\Core\View::e($o['nama']) . $k4 . '</option>';
    }
    return $h;
};
?>
