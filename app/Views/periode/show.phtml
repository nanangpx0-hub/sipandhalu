<script>
document.addEventListener('DOMContentLoaded', function () {
  var periodeId = <?= (int) $row['id'] ?>;

  // 1. Modal Terima Satuan
  $('.btn-terima-satuan').on('click', function () {
    var $b = $(this);
    var sid = $b.data('id');
    var nks = $b.data('nks');
    var sls = $b.data('sls');
    var petaLbl = $b.data('peta-lbl');
    var pclId = $b.data('pcl-id');
    var pmlId = $b.data('pml-id');
    var pclNama = $b.data('pcl-nama');
    var pmlNama = $b.data('pml-nama');
    var pemSt = $b.data('pem-st');
    var petaSt = $b.data('peta-st');
    var kk = $b.data('kk');
    var rt = $b.data('rt');
    var cat = $b.data('catatan');

    $('#satuanNksLabel').text('NKS: ' + nks);
    $('#satuanSlsLabel').text(sls);
    $('#formTerimaSatuan').attr('action', '/periode/' + periodeId + '/sampel/' + sid + '/terima');

    // Penyerah radio
    $('#optPenyerahPml').val(pmlId);
    $('#lblPenyerahPml').text('PML: ' + (pmlNama || '—'));
    $('#optPenyerahPcl').val(pclId);
    $('#lblPenyerahPcl').text('PCL: ' + (pclNama || '—'));
    if (pmlId) { $('#optPenyerahPml').prop('checked', true); }
    else if (pclId) { $('#optPenyerahPcl').prop('checked', true); }

    // Checkboxes
    $('#chkTerimaPem').prop('checked', pemSt !== 'DITERIMA');
    $('#infoStatusPem').text('Status saat ini: ' + pemSt);

    $('#lblPetaCheck').text(petaLbl);
    $('#chkTerimaPeta').prop('checked', petaSt !== 'DITERIMA');
    $('#infoStatusPeta').text('Status saat ini: ' + petaSt);

    $('#fldSatuanKk').val(kk || '');
    $('#fldSatuanRt').val(rt || '');
    $('#fldSatuanCatatan').val(cat || '');

    $('#modalTerimaSatuan').modal('show');
  });

  // 2. Modal Pinjam Dokumen
  $('.btn-pinjam-dok').on('click', function () {
    var $b = $(this);
    var sid = $b.data('id');
    var nks = $b.data('nks');
    var sls = $b.data('sls');
    var petaLbl = $b.data('peta-lbl');
    var pemSt = $b.data('pem-st');
    var petaSt = $b.data('peta-st');
    var pclId = $b.data('pcl-id');
    var pmlId = $b.data('pml-id');
    var pengolahId = $b.data('pengolah-id');
    var pclNama = $b.data('pcl-nama');
    var pmlNama = $b.data('pml-nama');
    var pengolahNama = $b.data('pengolah-nama');

    $('#pinjamNksLabel').text('NKS: ' + nks);
    $('#pinjamSlsLabel').text(sls);
    $('#formPinjamDokumen').attr('action', '/periode/' + periodeId + '/sampel/' + sid + '/pinjam');

    // Filter opsi jenis dokumen yang boleh dipinjam (hanya yang sudah DITERIMA)
    var $selJenis = $('#selPinjamJenis').empty();
    if (pemSt === 'DITERIMA' && petaSt === 'DITERIMA') {
      $selJenis.append('<option value="SEMUA">Semua (Pemutakhiran & ' + petaLbl + ')</option>');
    }
    if (pemSt === 'DITERIMA') {
      $selJenis.append('<option value="PEMUTAKHIRAN">Dokumen Pemutakhiran Saja</option>');
    }
    if (petaSt === 'DITERIMA') {
      $selJenis.append('<option value="PETA">' + petaLbl + ' Saja</option>');
    }

    // Peminjam
    var $selOrang = $('#selPinjamOrang').empty();
    if (pmlId) $selOrang.append('<option value="' + pmlId + '" data-peran="PML">PML: ' + pmlNama + '</option>');
    if (pclId) $selOrang.append('<option value="' + pclId + '" data-peran="PCL">PCL: ' + pclNama + '</option>');
    if (pengolahId) $selOrang.append('<option value="' + pengolahId + '" data-peran="PENGOLAH">Pengolah: ' + pengolahNama + '</option>');

    $selOrang.off('change').on('change', function () {
      var peran = $(this).find('option:selected').data('peran');
      if (peran) { $('#selPinjamPeran').val(peran); }
    }).trigger('change');

    $('#modalPinjamDokumen').modal('show');
  });

  // 3. Modal Terima Kolektif per PML (AJAX list NKS)
  $('#selKolektifPml').on('change', function () {
    var pmlId = $(this).val();
    if (!pmlId) {
      $('#wrapKolektifTable').hide();
      $('#kolektifEmptyMsg').show();
      $('#btnSubmitKolektif').prop('disabled', true);
      return;
    }

    $('#kolektifEmptyMsg').html('<div class="spinner-border spinner-border-sm text-primary"></div> Memuat daftar SLS binaan...').show();
    $('#wrapKolektifTable').hide();

    $.getJSON('/periode/' + periodeId + '/pml/' + pmlId + '/sampel', function (res) {
      var list = res.data || [];
      if (list.length === 0) {
        $('#kolektifEmptyMsg').html('Tidak ada SLS binaan yang ditugaskan ke PML ini.').show();
        $('#wrapKolektifTable').hide();
        $('#btnSubmitKolektif').prop('disabled', true);
        return;
      }

      var html = '';
      list.forEach(function (s) {
        var sid = s.id;
        var isSub = s.sub && s.sub !== '00';
        var petaLbl = isSub ? 'Peta WSS' : 'Peta WS';
        var isPemTerima = (s.dok_pemutakhiran_status === 'DITERIMA');
        var isPetaTerima = (s.peta_status === 'DITERIMA');

        html += '<tr>';
        html += '<td class="text-center align-middle"><input type="checkbox" name="items[' + sid + '][pilih]" value="1" class="kolektif-chk-item" checked></td>';
        html += '<td><b>' + s.nks + '</b><br><small class="text-muted">' + (s.nama_sls || '') + '</small></td>';
        html += '<td class="align-middle">';
        html += '<div class="custom-control custom-checkbox">';
        html += '<input type="checkbox" class="custom-control-input" id="k_pem_' + sid + '" name="items[' + sid + '][pemutakhiran]" value="1" ' + (isPemTerima ? '' : 'checked') + '>';
        html += '<label class="custom-control-label small" for="k_pem_' + sid + '">Pemutakhiran ' + (isPemTerima ? '<span class="badge badge-light border">Sudah</span>' : '') + '</label>';
        html += '</div></td>';
        html += '<td class="align-middle">';
        html += '<div class="custom-control custom-checkbox">';
        html += '<input type="checkbox" class="custom-control-input" id="k_peta_' + sid + '" name="items[' + sid + '][peta]" value="1" ' + (isPetaTerima ? '' : 'checked') + '>';
        html += '<label class="custom-control-label small" for="k_peta_' + sid + '">' + petaLbl + ' ' + (isPetaTerima ? '<span class="badge badge-light border">Sudah</span>' : '') + '</label>';
        html += '</div></td>';
        html += '<td><input type="number" class="form-control form-control-sm" name="items[' + sid + '][hasil_kk]" value="' + (s.hasil_kk || '') + '" placeholder="KK"></td>';
        html += '<td><input type="number" class="form-control form-control-sm" name="items[' + sid + '][hasil_rt]" value="' + (s.hasil_rt || '') + '" placeholder="RT"></td>';
        html += '</tr>';
      });

      $('#tbodyKolektif').html(html);
      $('#kolektifEmptyMsg').hide();
      $('#wrapKolektifTable').show();
      $('#btnSubmitKolektif').prop('disabled', false);
    });
  });

  $('#btnCheckAllKolektif').on('click', function () {
    var $chks = $('.kolektif-chk-item');
    var allChecked = $chks.length === $chks.filter(':checked').length;
    $chks.prop('checked', !allChecked);
  });

