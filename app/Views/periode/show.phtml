<script>
document.addEventListener('DOMContentLoaded', function () {
  var csrfToken = <?= json_encode(\App\Core\Csrf::token()) ?>;
  var periodeId = <?= (int) $row['id'] ?>;
  var currentSampelId = null;

  // Nama file import dok kirim
  $('#fileDokKirim').on('change', function () {
    $('#lblFileDokKirim').text(this.files[0] ? this.files[0].name : 'Pilih file...');
  });

  function rutaAlert(msg, ok) {
    $('#rutaAlert').html('<div class="alert alert-' + (ok ? 'success' : 'danger') + ' alert-dismissible fade show py-2 mb-0">' + msg + '<button type="button" class="close py-1" data-dismiss="alert">&times;</button></div>');
  }

  function loadRuta(sid) {
    $('#tbodyRuta').html('<tr><td colspan="8" class="text-center text-muted py-3">Memuat...</td></tr>');
    $.getJSON('/periode/' + periodeId + '/sampel/' + sid + '/ruta', function (res) {
      var html = '';
      (res.ruta || []).forEach(function (r) {
        var sud = r.status_selesai === 'SUDAH';
        html += '<tr data-no="' + r.no_urut_ruta + '">';
        html += '<td class="text-center font-weight-bold">' + r.no_urut_ruta + '</td>';
        html += '<td class="text-center"><div class="custom-control custom-switch d-inline-block">';
        html += '<input type="checkbox" class="custom-control-input ruta-chk-status" id="chkSt_' + r.no_urut_ruta + '"' + (sud ? ' checked' : '') + '>';
        html += '<label class="custom-control-label small font-weight-bold" for="chkSt_' + r.no_urut_ruta + '">' + (sud ? 'SUDAH' : 'BELUM') + '</label></div></td>';
        html += '<td class="text-center"><input type="checkbox" class="ruta-chk-modul"' + ((+r.catatan_modul) ? ' checked' : '') + '></td>';
        html += '<td class="text-center"><input type="checkbox" class="ruta-chk-kp"' + ((+r.catatan_kp) ? ' checked' : '') + '></td>';
        html += '<td><input type="date" class="form-control form-control-sm ruta-tgl" value="' + (r.tgl_pengiriman || '') + '"></td>';
        html += '<td><input type="text" class="form-control form-control-sm ruta-ttd-sos" maxlength="100" value="' + (r.ttd_sos || '') + '" placeholder="Paraf Tim Sos"></td>';
        html += '<td><input type="text" class="form-control form-control-sm ruta-ttd-ipds" maxlength="100" value="' + (r.ttd_ipds || '') + '" placeholder="Paraf Tim IPDS"></td>';
        html += '<td class="text-center"><button type="button" class="btn btn-xs btn-primary btn-save-ruta" data-no="' + r.no_urut_ruta + '"><i class="fas fa-save"></i></button></td>';
        html += '</tr>';
      });
      $('#tbodyRuta').html(html);
    }).fail(function () {
      $('#tbodyRuta').html('<tr><td colspan="8" class="text-center text-danger py-3">Gagal memuat data ruta.</td></tr>');
    });
  }

  $(document).on('click', '.btn-rincian-ruta', function () {
    currentSampelId = +$(this).data('id');
    $('#rutaNksLabel').text('NKS ' + $(this).data('nks'));
    $('#rutaSlsLabel').text($(this).data('sls') || '-');
    $('#rutaAlert').empty();
    $('#modalRincianRuta').modal('show');
    loadRuta(currentSampelId);
  });

  $(document).on('change', '.ruta-chk-status', function () {
    $(this).next('label').text(this.checked ? 'SUDAH' : 'BELUM');
  });

  $(document).on('click', '.btn-save-ruta', function () {
    var no = $(this).data('no');
    var tr = $('#tbodyRuta tr[data-no="' + no + '"]');
    var btn = $(this);
    btn.prop('disabled', true);
    $.post('/periode/' + periodeId + '/sampel/' + currentSampelId + '/ruta', {
      no_urut_ruta: no,
      status_selesai: tr.find('.ruta-chk-status').prop('checked') ? 'SUDAH' : 'BELUM',
      catatan_modul: tr.find('.ruta-chk-modul').prop('checked') ? '1' : '0',
      catatan_kp: tr.find('.ruta-chk-kp').prop('checked') ? '1' : '0',
      tgl_pengiriman: tr.find('.ruta-tgl').val(),
      ttd_sos: tr.find('.ruta-ttd-sos').val(),
      ttd_ipds: tr.find('.ruta-ttd-ipds').val(),
      _csrf: csrfToken
    }).done(function (res) {
      rutaAlert(res.message || 'Tersimpan.', true);
      btn.prop('disabled', false);
    }).fail(function (xhr) {
      var m = 'Gagal menyimpan.';
      try { m = JSON.parse(xhr.responseText).message || m; } catch (e) {}
      rutaAlert(m, false);
      btn.prop('disabled', false);
    });
  });

  $('#btnSelesaiSemuaRuta').on('click', function () {
    var btn = $(this);
    if (!currentSampelId) return;
    btn.prop('disabled', true);
    $.post('/periode/' + periodeId + '/sampel/' + currentSampelId + '/ruta/selesai-semua', {
      tgl_pengiriman: $('#rutaTglSemua').val(),
      ttd: $('#rutaTtdSemua').val(),
      _ajax: '1',
      _csrf: csrfToken
    }).done(function (res) {
      rutaAlert(res.message || 'Selesai.', true);
      btn.prop('disabled', false);
      loadRuta(currentSampelId);
    }).fail(function (xhr) {
      var m = 'Gagal.';
      try { m = JSON.parse(xhr.responseText).message || m; } catch (e) {}
      rutaAlert(m, false);
      btn.prop('disabled', false);
    });
  });
});
</script>

<?php require __DIR__ . '/../layouts/footer.phtml'; ?>


  // 4. Modal Riwayat Dokumen
  $('.btn-riwayat-dok').on('click', function () {
    var $b = $(this);
    var sid = $b.data('id');
    var nks = $b.data('nks');

    $('#riwayatNksLabel').text('NKS: ' + nks);
    $('#tbodyRiwayat').html('<tr><td colspan="6" class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Memuat...</td></tr>');
    $('#wrapPinjamAktif').hide();
    $('#modalRiwayatDokumen').modal('show');

    $.getJSON('/periode/' + periodeId + '/sampel/' + sid + '/riwayat-dokumen', function (res) {
      var s = res.sampel || {};
      $('#riwayatSlsLabel').text(s.nama_sls || '');

      // Check pinjaman aktif
      var active = res.activePinjam || [];
      if (active.length > 0) {
        var act = active[0];
        $('#fldKembaliPinjamId').val(act.id);
        $('#txtInfoPinjamAktif').html('<b>' + act.jenis_dok + '</b> dipinjam oleh <b>' + (act.peminjam_nama || '-') + ' (' + act.peminjam_peran + ')</b> pada ' + act.waktu_pinjam + '<br><span class="text-muted">Alasan: ' + act.alasan + '</span>');
        $('#wrapPinjamAktif').show();
      } else {
        $('#wrapPinjamAktif').hide();
      }

      // Render histori
      var hist = res.riwayat || [];
      if (hist.length === 0) {
        $('#tbodyRiwayat').html('<tr><td colspan="6" class="text-center text-muted py-3">Belum ada catatan riwayat peminjaman dokumen untuk NKS ini.</td></tr>');
        return;
      }

      var html = '';
      hist.forEach(function (h) {
        var isKemb = (h.status === 'DIKEMBALIKAN');
        var badge = isKemb ? '<span class="badge badge-success">Dikembalikan</span>' : '<span class="badge badge-warning text-dark">Sedang Dipinjam</span>';
        html += '<tr>';
        html += '<td class="small text-nowrap">' + h.waktu_pinjam + '</td>';
        html += '<td><span class="badge badge-light border">' + h.jenis_dok + '</span></td>';
        html += '<td><b>' + (h.peminjam_nama || '-') + '</b> <small class="text-muted">(' + h.peminjam_peran + ')</small></td>';
        html += '<td class="small">' + h.alasan + '</td>';
        html += '<td>' + badge + '</td>';
        html += '<td class="small text-nowrap">' + (h.waktu_kembali || '—') + (h.catatan_kembali ? '<br><small class="text-muted">' + h.catatan_kembali + '</small>' : '') + '</td>';
        html += '</tr>';
      });
      $('#tbodyRiwayat').html(html);
    });
  });
});
</script>

