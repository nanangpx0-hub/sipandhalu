function inisial(string $nama): string
{
    $p = preg_split('/\s+/', trim($nama)) ?: [];
    $i = strtoupper(mb_substr($p[0] ?? 'U', 0, 1) . mb_substr($p[1] ?? '', 0, 1));
    return $i !== '' ? $i : 'U';
}
