function badgeRolePetugas(?string $code, ?string $label): string {
    if (!$code) {
        return '<span class="text-muted">—</span>';
    }
    $styles = [
        'ADMIN' => 'background:#dc3545;color:#fff;',
        'OPERATOR' => 'background:#007bff;color:#fff;',
        'PML' => 'background:#ffc107;color:#212529;',
        'PCL' => 'background:#28a745;color:#fff;',
        'PENGOLAH' => 'background:#17a2b8;color:#fff;',
        'PENGAWAS_OLAH' => 'background:#6f42c1;color:#fff;',
        'SM_SOSIAL' => 'background:#20c997;color:#fff;',
        'SM_PLS' => 'background:#6610f2;color:#fff;',
        'VIEWER' => 'background:#6c757d;color:#fff;',
    ];
    $icons = [
        'ADMIN' => 'fa-user-shield',
        'OPERATOR' => 'fa-user-cog',
        'PML' => 'fa-binoculars',
        'PCL' => 'fa-walking',
        'PENGOLAH' => 'fa-user-edit',
        'PENGAWAS_OLAH' => 'fa-clipboard-check',
        'SM_SOSIAL' => 'fa-user-tie',
        'SM_PLS' => 'fa-server',
        'VIEWER' => 'fa-user',
    ];
    $st = $styles[$code] ?? 'background:#6c757d;color:#fff;';
    $ic = $icons[$code] ?? 'fa-user';
    $lbl = \App\Core\View::e($label ?? $code);
    return "<span class=\"badge p-1 px-2\" style=\"{$st}\"><i class=\"fas {$ic} mr-1\"></i>{$lbl}</span>";
}
